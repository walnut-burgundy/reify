-- Idriç sketch: two substitutions that can only be applied together.
-- This is intentionally tiny and does not commit the project to final syntax.

data Substitution : Type where
  (↦) : Text → Text → Substitution

data CoupledSubstitution : Type where
  together : Substitution → Substitution → CoupledSubstitution

shark_ecology : CoupledSubstitution
shark_ecology is together
  ("sharks" ↦ "foxes")
  ("fish"   ↦ "chickens")

apply : CoupledSubstitution → Text → Maybe Text
apply (together (left_from ↦ left_to) (right_from ↦ right_to)) text is
  if contains left_from text AND contains right_from text
    then Just
      (text
        |> replace left_from left_to
        |> replace right_from right_to)
    otherwise Nothing

-- Both source words are checked before either replacement becomes a result:
--
--   apply shark_ecology "sharks eat fish"
--   = Just "foxes eat chickens"
--
--   apply shark_ecology "sharks circle the reef"
--   = Nothing
--
--   apply shark_ecology "fish scatter over the reef"
--   = Nothing
--
-- There is no operation here that applies one member of a coupled
-- substitution. The caller receives the complete result or Nothing.

-- Plain sed contrast
-- ------------------
--
-- Two ordinary sed substitutions are sequential and independent:
--
--   printf '%s\n' 'sharks circle the reef' |
--     sed -e 's/sharks/foxes/g' -e 's/fish/chickens/g'
--
--   foxes circle the reef
--
-- The first substitution changed the text even though the second found no
-- match. That is the partial result this example refuses. sed can guard both
-- commands by checking for both words in one pattern space. Making an entire
-- streamed file all-or-nothing instead requires staging the output before it
-- replaces the original; ordinary s/// commands do not provide rollback.
